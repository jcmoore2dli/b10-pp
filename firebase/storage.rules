rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // TOEFL enrollment gate (2026-09-19), mirroring hasToeflAccess() in
    // firestore.rules. TOEFL and B10-PP share one Auth pool, and the old
    // /audio/{allPaths=**} rule let every signed-in account read all TOEFL
    // listening audio. A student is enrolled when toeflEnrollment/{b10Id}
    // exists in Firestore for their b10Id claim, checked through a
    // cross-service firestore.exists() call. That call needs the Storage
    // service to hold Firestore read permission on this project, which the
    // console offers to grant on the first deploy of these rules. Only
    // callers who already passed request.auth != null reach this, so the
    // token is safe to read. The enrollment must also be active, exactly as
    // in firestore.rules: not frozen, and not past expiresAt.
    function toeflEnrollmentPath() {
      return /databases/(default)/documents/toeflEnrollment/$(request.auth.token.b10Id);
    }

    function isActiveToeflEnrollment(e) {
      return e.get('frozen', false) != true &&
        (e.get('expiresAt', null) == null || request.time < e.expiresAt);
    }

    function hasToeflAccess() {
      // .get() with a default: most tokens carry no role or b10Id claim, and
      // a missing property would otherwise be an evaluation error.
      return request.auth.token.get('role', '') in ['instructor', 'admin'] ||
        (request.auth.token.get('b10Id', null) != null &&
         firestore.exists(toeflEnrollmentPath()) &&
         isActiveToeflEnrollment(firestore.get(toeflEnrollmentPath()).data));
    }

    // One match for all of audio/, split on the first segment. A separate
    // match for audio/toefl/** would not narrow anything: Storage allows a
    // request if ANY matching rule allows it, so the broad rule has to carry
    // the exception itself. {rest=**} matches zero or more segments (rules
    // v2), so files directly under audio/ still match with top = file name.
    match /audio/{top}/{rest=**} {
      // TOEFL stimulus audio: enrolled students and staff only. Everything
      // else under audio/ is unchanged (any signed-in account).
      allow read: if request.auth != null &&
        (top != "toefl" || hasToeflAccess());

      // Unchanged for B10-PP and for student recordings, which live under
      // audio/{b10Id}/... (TOEFL's included: audio/{b10Id}/toefl_{attemptId}/).
      // audio/toefl/ itself is stimulus, written only by the admin-SDK upload
      // scripts, which bypass rules; no client may write there.
      allow write: if request.auth != null &&
        request.auth.token.get('b10Id', null) != null &&
        top != "toefl";
    }
  }
}
